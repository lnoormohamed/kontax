{
  "compilerOptions": {
    /* Base Options: */
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "es2022",
    "allowJs": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    /* Strictness */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "checkJs": true,

    /* Bundled projects */
    "lib": ["dom", "dom.iterable", "ES2022"],
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "plugins": [{ "name": "next" }],
    "incremental": true,

    /* Path Aliases */
    "baseUrl": ".",
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.cjs",
    "**/*.js",
    ".next/types/**/*.ts",
    ".next-verify/types/**/*.ts",
    // P48-13: TypeScript's glob matching skips any path with a dot-prefixed
    // segment by default, so the bare "**/*.ts" pattern above silently never
    // covered the CardDAV well-known redirect route — `tsc` type-checked
    // around it and typed-lint rules (via ESLint's projectService) failed to
    // parse it ("was not found by the project service"). Needs an explicit
    // entry; any future route under a dot-directory needs the same treatment.
    "src/app/.well-known/**/*.ts"
  ],
  "exclude": ["node_modules", "generated", "roadmap", ".claude"]
}

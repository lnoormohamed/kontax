# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage
# Playwright output (traces, videos, .last-run.json) — P48-13, never commit
/test-results/

# database
/prisma/db.sqlite
/prisma/db.sqlite-journal
db.sqlite

# next.js
/.next/
/.next-*/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
# do not commit any .env files to git, except for the .env.example file. https://create.t3.gg/en/usage/env-variables#using-environment-variables
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo

# prisma client — regenerated by `npm ci`'s postinstall (`prisma generate`)
# from prisma/schema.prisma; never commit a platform-specific build (P48-15).
/generated/

# idea files
.idea
# Claude Code agent worktrees
/.claude/worktrees/

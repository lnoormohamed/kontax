generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum AccountLifecycleState {
    ACTIVE
    TRIALING
    GRACE
    CANCELED
    LOCKED
}

// P21-01: platform staff role. ADMIN unlocks the internal /admin tooling.
enum UserRole {
    USER
    ADMIN
}

// P20-10: SES delivery status. BOUNCED/COMPLAINED addresses are suppressed from
// further sends to protect sender reputation.
enum EmailStatus {
    OK
    BOUNCED
    COMPLAINED
}

enum BillingProvider {
    STRIPE
}

enum SubscriptionPlan {
    FREE
    PRO
    FAMILY
    TEAMS
}

enum GroupType {
    FAMILY
    TEAM
}

enum GroupRole {
    OWNER
    ADMIN
    MEMBER
}

enum GroupInviteStatus {
    PENDING
    ACCEPTED
    DECLINED
    REVOKED
}

enum SubscriptionStatus {
    INCOMPLETE
    TRIALING
    ACTIVE
    PAST_DUE
    CANCELED
    PAUSED
    EXPIRED
}

enum SubscriptionInterval {
    MONTHLY
    YEARLY
}

enum ImportExportJobStatus {
    PENDING
    PROCESSING
    COMPLETED
    FAILED
}

// P29-02: async GDPR data-export job lifecycle
enum DataExportStatus {
    PENDING
    PROCESSING
    READY
    EXPIRED
    FAILED
}

enum ApiTokenScope {
    READ_ONLY
    READ_WRITE
}

enum ContactImportFormat {
    CSV_GENERIC
}

enum ContactExportFormat {
    CSV_GENERIC
    VCARD_4
}

enum ImportSourceProfile {
    GENERIC
    GOOGLE
    APPLE
    OUTLOOK
}

enum MergeSuggestionStatus {
    OPEN
    DISMISSED
    MERGED
    STALE
}

enum MergeSuggestionConfidence {
    HIGH
    MEDIUM
    LOW
}

enum MergeDecisionStatus {
    ACCEPTED
    REJECTED
    REVERSED
}

enum SyncProvider {
    CARDDAV
    // P27-01: Google Contacts via OAuth 2.0 + People API. Credentials hold an
    // OAuth token envelope (access/refresh/expiry) instead of username/password.
    GOOGLE
    // P27-04: Microsoft Outlook/Exchange via OAuth 2.0 + Graph API. Same OAuth
    // token envelope; lastSyncCursor stores the Graph delta link.
    MICROSOFT
}

enum SyncDirection {
    TWO_WAY
    IMPORT_ONLY
    EXPORT_ONLY
}

enum SyncAccountStatus {
    // Healthy and runnable.
    ACTIVE
    // Temporarily stopped by the user or by an auto-pause safety rule.
    PAUSED
    // Credentials/token broken; user action is required before the next run.
    NEEDS_REAUTH
    // Operational failure that does not inherently invalidate credentials.
    ERROR
    // P36-DB03: soft-disconnected. Credentials revoked, hidden from the active
    // rail and skipped by the runner, but settings + contact links are retained so
    // re-adding the same remote (matched by email / baseUrl+label) restores it.
    DISCONNECTED
    // P34G-02: intentionally replaced by a newer connection. Historical-only:
    // preserved for audit/support and never eligible for normal reconnect flows.
    RETIRED
}

// P23-01: per-connection conflict resolution policy.
enum ConflictPolicy {
    SERVER_WINS // remote change always wins
    DEVICE_WINS // Kontax change always wins (export-biased) — see data-loss note in P23-01
    MANUAL // write a SyncConflict row for user review
}

enum SyncJobTrigger {
    MANUAL
    SCHEDULED
    WEBHOOK
    RECOVERY
}

enum SyncJobStatus {
    QUEUED
    RUNNING
    SUCCEEDED
    PARTIAL
    FAILED
}

enum SyncConflictType {
    LOCAL_REMOTE_MUTATION
    DELETE_CONFLICT
    MERGE_CONFLICT
    VERSION_MISMATCH
}

enum SyncConflictStatus {
    OPEN
    RESOLVED
    IGNORED
    // P23-05: conflict auto-resolved by the connection's SERVER_WINS / DEVICE_WINS
    // policy — kept as an audit record, never shown in the manual review queue.
    AUTO_RESOLVED
}

enum SyncConflictSource {
    OUTBOUND_SYNC
    INBOUND_DEVICE
}

enum SyncResolutionStrategy {
    KEEP_LOCAL
    KEEP_REMOTE
    DUPLICATE_LOCAL
    ARCHIVE_LOCAL
    MANUAL_MERGE
}

enum SourceType {
    MANUAL
    IMPORT_CSV
    SYNC_CARDDAV
    // P27-02: contacts imported via the Google Contacts OAuth connector.
    SYNC_GOOGLE
    // P27-04: contacts imported via the Microsoft Outlook/Graph connector.
    SYNC_MICROSOFT
    SHARED_STATIC
    SHARED_LIVE
    API
    // P30-04: contact saved from a public card page
    CARD_IMPORT
}

model User {
    id                    String                  @id @default(cuid())
    name                  String?
    email                 String                  @unique
    password              String
    lifecycleState        AccountLifecycleState   @default(ACTIVE)
    autoFillPhoneticNames Boolean                 @default(false)
    // P18-02: incremented on password change / session revoke; JWT must match or is rejected
    sessionVersion        Int                     @default(1)
    // P18-01: optional profile photo URL (served from MinIO)
    avatarUrl                     String?
    // P18-04: null = unverified; set to now() on token consumption
    emailVerified                 DateTime?
    // P18-03: pending email change (cleared on activation or cancellation)
    emailPendingChange            String?
    emailPendingChangeRequestedAt DateTime?
    // P20-10: SES bounce/complaint status — suppresses sends when not OK
    emailStatus                   EmailStatus @default(OK)
    // P18-07: TOTP two-factor authentication
    totpEnabled                   Boolean   @default(false)
    totpSecret                    String?   // AES-256-GCM encrypted
    totpVerifiedAt                DateTime?
    // P18-09: scheduled hard-delete (30-day grace period after user confirms deletion)
    scheduledDeleteAt             DateTime?
    // P21-01: platform admin role (default USER). Gates the /admin surfaces.
    role                          UserRole  @default(USER)
    // P21-04: admin plan override — set the local plan without touching Stripe.
    planOverrideReason            String?
    planOverriddenAt              DateTime?
    appPasswords          AppPassword[]
    contacts              Contact[]
    importJobs            ImportJob[]
    exportJobs            ExportJob[]
    mergeSuggestions      MergeSuggestion[]
    mergeDecisions        MergeDecision[]
    dismissals            MergeDismissal[]
    syncAccounts          SyncAccount[]
    subscriptionCustomer  SubscriptionCustomer?
    subscriptions         Subscription[]
    activityEvents        ActivityEvent[]
    ownedGroups           Group[]                 @relation("GroupOwner")
    groupMemberships      GroupMember[]
    contactSharesOwned    ContactShare[]          @relation("ShareOwner")
    contactSharesReceived ContactShare[]          @relation("ShareRecipient")
    emailVerificationTokens EmailVerificationToken[]
    passwordResetTokens     PasswordResetToken[]
    sessions                UserSession[]
    totpRecoveryCodes       TotpRecoveryCode[]
    addressBooks            AddressBook[]
    // P28-02: smart lists (saved contact filters)
    savedFilters            SavedFilter[]
    adminAuditEvents        AdminAuditEvent[]       @relation("AdminActor")
    // P22-DB05: in-app notification layer
    notifications           Notification[]
    securityAlerts          SecurityAlert[]
    notificationSettings    NotificationSettings?
    // P22-09/10: birthday reminders + lead-time preference
    reminderLeadDays        Int                     @default(7)
    birthdayReminderStates              BirthdayReminderState[]
    importMappingSuggestionFeedbacks    ImportMappingSuggestionFeedback[]
    importMappingPresets                ImportMappingPreset[]
    exportPresets                       ExportPreset[]
    // P29-02: async GDPR data-export jobs
    dataExportJobs                      DataExportJob[]
    // P29-05: developer API access tokens
    apiTokens                           ApiToken[]
    // P31B-01: label registry
    labels                              Label[]
    // P22-11: subscribable iCal calendar token (revocable credential).
    // NOT a DB @unique constraint: the startup `prisma db push --skip-generate`
    // (Dockerfile) has no --accept-data-loss, so adding a unique index to a new
    // column would crash-loop the deploy. Uniqueness is guaranteed by the 24-byte
    // random token (generateCalToken) and looked up via findFirst. Indexed below.
    calToken                String?
    // P22-04: repeated failed-login detection
    failedLoginAttempts     FailedLoginAttempt[]
    // P26-04: first-run onboarding checklist state
    onboardingState         UserOnboardingState?
    // P30-01: public card username (powers /u/{username})
    username                String?   @unique
    usernameClaimedAt       DateTime?
    // P30-03: per-field visibility config for the public card (null = defaults)
    publicCardFields        Json?
    // P30-06: card analytics counters
    publicCardViews         Int       @default(0)
    addToKontaxClicks       Int       @default(0)
    cardViewLog             PublicCardView[]
    // P34B-01: per-user UI preferences (sort, view mode, date format, name order, week start)
    preferences             Json?     @default("{}")
    createdAt             DateTime                @default(now())
    updatedAt             DateTime                @updatedAt

    @@index([scheduledDeleteAt])
    @@index([calToken])
}

// P26-04: first-run onboarding checklist state. The "create account", "add a
// contact", and "connect a sync account" steps are derived live from existing
// P30-06: one row per public card page view (kept 90 days, pruned by cron).
// Counter on User (publicCardViews) is the durable total; this table powers the
// 30-day breakdown in settings without a full table scan.
model PublicCardView {
    id        String   @id @default(cuid())
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    viewedAt  DateTime @default(now())
    referrer  String?  @db.VarChar(500)

    @@index([userId, viewedAt])
}

// data; only the route-visit ("explore") trigger and the dismiss/complete
// lifecycle need persisting here. One row per user, created lazily on first
// dismiss/explore/complete.
model UserOnboardingState {
    id          String    @id @default(cuid())
    userId      String    @unique
    user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    // set the first time the user opens the contacts list with >= 1 contact
    exploredAt  DateTime?
    // set when the user dismisses the checklist (× or the completion "Dismiss")
    dismissedAt DateTime?
    // set when all four steps are complete and the success card has been shown
    completedAt DateTime?
    // P26-14: Family/Teams upgrade onboarding. Plan whose getting-started flow was
    // completed ("FAMILY" | "TEAMS"), and when — so the wizard runs once per upgrade.
    upgradeOnboardingPlan        String?
    upgradeOnboardingCompletedAt DateTime?
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt
}

model AppPassword {
    id             String   @id @default(cuid())
    userId         String
    label          String
    hashedPassword String
    lastUsedAt     DateTime?
    revokedAt      DateTime?
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt
    user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    syncConflicts  SyncConflict[]

    @@index([userId, revokedAt, createdAt])
    @@index([userId, revokedAt])
}

model Contact {
    id          String    @id @default(cuid())
    userId      String
    user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    importJobId String?
    importJob   ImportJob? @relation(fields: [importJobId], references: [id], onDelete: SetNull)
    leftMergeSuggestions  MergeSuggestion[] @relation("MergeSuggestionLeftContact")
    rightMergeSuggestions MergeSuggestion[] @relation("MergeSuggestionRightContact")
    dismissalsAsA         MergeDismissal[]  @relation("DismissalA")
    dismissalsAsB         MergeDismissal[]  @relation("DismissalB")
    syncLinks   SyncContactLink[]
    syncConflicts SyncConflict[]
    activityEvents ActivityEvent[]
    sharesFromContact     ContactShare[] @relation("ShareSourceContact")
    sharesAsRecipientCopy ContactShare[] @relation("ShareRecipientContact")
    groupContacts         GroupContact[]
    // P22-10: per-contact reminder lead-time override (null = use User.reminderLeadDays)
    reminderLeadDaysOverride Int?
    // P22-09: dedup state for birthday/anniversary reminders
    birthdayReminderStates   BirthdayReminderState[]
    mergedIntoContactId String?
    mergedIntoContact Contact? @relation("ContactMergeLineage", fields: [mergedIntoContactId], references: [id], onDelete: SetNull)
    mergedChildren Contact[] @relation("ContactMergeLineage")
    syncUid     String    @default(cuid())
    syncVersion Int       @default(1)
    syncTombstoneAt DateTime?
    fullName    String
    firstName   String?
    middleName  String?
    lastName    String?
    phoneticFirstName String?
    phoneticLastName  String?
    namePrefix  String?
    nameSuffix  String?
    nickname    String?
    email       String?
    phone       String?
    company     String?
    phoneticCompany String?
    jobTitle    String?
    department  String?
    website     String?
    birthday    String?
    address     String?
    avatarUrl   String?
    isFavorite  Boolean   @default(false)
    isEmergency Boolean   @default(false)
    labels      Json?
    websiteEntries Json?
    emailAddresses Json?
    phoneNumbers   Json?
    postalAddresses Json?
    emailEntries   Json?
    phoneEntries   Json?
    addressEntries Json?
    significantDates Json?
    relatedPeople Json?
    customFields  Json?
    notes       String?
    sourceType          SourceType @default(MANUAL)
    sourceDetail        String?
    lastMutatedBy       SourceType @default(MANUAL)
    lastMutatedByDetail String?
    archivedAt  DateTime?
    // P18-11: address book grouping (nullable for safe migration; backfilled to default book)
    bookId      String?
    book        AddressBook? @relation(fields: [bookId], references: [id], onDelete: SetNull)
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    @@unique([userId, syncUid])
    @@index([userId, archivedAt, fullName])
    @@index([userId, archivedAt, nickname])
    @@index([userId, archivedAt, email])
    @@index([userId, archivedAt, phone])
    @@index([userId, importJobId])
    @@index([userId, mergedIntoContactId])
    @@index([bookId, archivedAt, fullName])
}

model SubscriptionCustomer {
    id                 String            @id @default(cuid())
    // P34F-01: exactly one of userId / groupId is non-null. Personal plans set
    // userId (unchanged); Teams set groupId (org-anchored billing). Invariant
    // enforced by a CHECK constraint (scripts/sql/p34f-billing-owner-checks.sql)
    // and assertSingleBillingOwner in src/server/billing-owner.ts.
    userId             String?           @unique
    groupId            String?           @unique
    provider           BillingProvider   @default(STRIPE)
    providerCustomerId String
    billingEmail       String?
    createdAt          DateTime          @default(now())
    updatedAt          DateTime          @updatedAt
    user               User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
    group              Group?            @relation(fields: [groupId], references: [id], onDelete: Cascade)
    subscriptions      Subscription[]

    @@unique([provider, providerCustomerId])
}

model Subscription {
    id                     String               @id @default(cuid())
    // P34F-01: org-anchored billing. userId is null for Teams (set for personal);
    // groupId is set for Teams. Exactly one is non-null (see SubscriptionCustomer).
    userId                 String?
    groupId                String?
    subscriptionCustomerId String
    provider               BillingProvider      @default(STRIPE)
    providerSubscriptionId String
    plan                   SubscriptionPlan     @default(FREE)
    status                 SubscriptionStatus   @default(TRIALING)
    interval               SubscriptionInterval @default(MONTHLY)
    contactsLimit          Int?
    monthlyImportLimit     Int?
    syncAccountsLimit      Int?
    appPasswordsLimit        Int?
    advancedMergeEnabled   Boolean              @default(false)
    premiumExportEnabled   Boolean              @default(false)
    cardDavSyncEnabled     Boolean              @default(false)
    familyGroupEnabled       Boolean              @default(false)
    teamsEnabled             Boolean              @default(false)
    sharedAddressBooksLimit  Int?
    memberSlotsLimit         Int?
    activityLogRetentionDays Int?
    liveShareEnabled         Boolean              @default(false)
    staticShareEnabled       Boolean              @default(false)
    startedAt              DateTime             @default(now())
    currentPeriodStart     DateTime?
    currentPeriodEnd       DateTime?
    trialEndsAt            DateTime?
    graceEndsAt            DateTime?
    cancelAtPeriodEnd      Boolean              @default(false)
    canceledAt             DateTime?
    endedAt                DateTime?
    createdAt              DateTime             @default(now())
    updatedAt              DateTime             @updatedAt
    user                   User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
    subscriptionCustomer   SubscriptionCustomer @relation(fields: [subscriptionCustomerId], references: [id], onDelete: Cascade)
    // Groups that point at this subscription as their *current* subscription
    // (via Group.subscriptionId). Distinct from `group` below (the org that
    // *owns* this subscription row when Teams billing is org-anchored).
    groups                 Group[]              @relation("GroupCurrentSubscription")
    group                  Group?               @relation("GroupOrgSubscriptions", fields: [groupId], references: [id], onDelete: Cascade)

    @@unique([provider, providerSubscriptionId])
    @@index([userId, status])
    @@index([groupId, status])
    @@index([subscriptionCustomerId, status])
}

model ImportJob {
    id                  String                @id @default(cuid())
    userId              String
    format              ContactImportFormat
    sourceProfile       ImportSourceProfile?
    status              ImportExportJobStatus @default(PENDING)
    sourceFileName      String?
    sourceFileSizeBytes Int?
    rowCount            Int                   @default(0)
    previewContactCount Int                   @default(0)
    importedCount       Int                   @default(0)
    skippedCount        Int                   @default(0)
    errorCount          Int                   @default(0)
    warningCount        Int                   @default(0)
    rolledBackCount     Int                   @default(0)
    errorSummary        String?
    previewedAt         DateTime?
    committedAt         DateTime?
    rolledBackAt        DateTime?
    createdAt           DateTime              @default(now())
    startedAt           DateTime              @default(now())
    completedAt         DateTime?
    updatedAt           DateTime              @updatedAt
    user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
    contacts            Contact[]

    @@index([userId, status, createdAt])
}

model ExportJob {
    id              String                @id @default(cuid())
    userId          String
    format          ContactExportFormat
    status          ImportExportJobStatus @default(PENDING)
    includeArchived Boolean               @default(false)
    filterQuery     String?
    resultFileName  String?
    exportedCount   Int                   @default(0)
    errorSummary    String?
    createdAt       DateTime              @default(now())
    startedAt       DateTime              @default(now())
    completedAt     DateTime?
    updatedAt       DateTime              @updatedAt
    user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId, status, createdAt])
}

model MergeSuggestion {
    id             String                    @id @default(cuid())
    userId         String
    leftContactId  String
    rightContactId String
    pairKey        String
    status         MergeSuggestionStatus     @default(OPEN)
    confidence     MergeSuggestionConfidence
    score          Int
    hardMatch      Boolean                   @default(false)
    signals        Json
    reasons        Json
    source         String
    generatedAt    DateTime                  @default(now())
    reviewedAt     DateTime?
    createdAt      DateTime                  @default(now())
    updatedAt      DateTime                  @updatedAt
    user           User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
    leftContact    Contact                   @relation("MergeSuggestionLeftContact", fields: [leftContactId], references: [id], onDelete: Cascade)
    rightContact   Contact                   @relation("MergeSuggestionRightContact", fields: [rightContactId], references: [id], onDelete: Cascade)
    decisions      MergeDecision[]

    @@unique([userId, pairKey])
    @@index([userId, status, updatedAt])
}

model MergeDecision {
    id                String              @id @default(cuid())
    suggestionId      String
    userId            String
    status            MergeDecisionStatus
    source            String
    notes             String?
    details           Json?
    decidedAt         DateTime            @default(now())
    reversedAt        DateTime?
    reversalSource    String?
    createdAt         DateTime            @default(now())
    updatedAt         DateTime            @updatedAt
    suggestion        MergeSuggestion     @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
    user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId, status, decidedAt])
    @@index([suggestionId, decidedAt])
}

model MergeDismissal {
    id          String   @id @default(cuid())
    userId      String
    contactAId  String
    contactBId  String
    dismissedAt DateTime @default(now())

    user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    contact_a Contact @relation("DismissalA", fields: [contactAId], references: [id], onDelete: Cascade)
    contact_b Contact @relation("DismissalB", fields: [contactBId], references: [id], onDelete: Cascade)

    @@unique([userId, contactAId, contactBId])
    @@index([userId])
}

model SyncAccount {
    id                  String            @id @default(cuid())
    userId              String
    // P34G-01: stable logical connection identity. Nullable for deploy-safe
    // `db push`; all new writes set it immediately and a backfill script fills
    // legacy rows before any code relies on it being present.
    //
    // IMPORTANT: do not add a DB-level @unique here. The production container
    // runs `prisma db push` during startup, and Prisma treats new unique
    // constraints on existing tables as potential data-loss operations. That
    // would crash-loop the app unless someone manually applies `--accept-data-loss`.
    // We keep this indexed and enforce the intended one-row-per-logical-connection
    // behavior in app code / invariants instead.
    connectionId        String?
    // Replacement lineage links are also intentionally non-unique at the schema
    // level for the same deploy-safety reason. They remain indexed for support
    // queries and validated by lineage invariants.
    replacesSyncAccountId String?
    replacedBySyncAccountId String?
    provider            SyncProvider      @default(CARDDAV)
    status              SyncAccountStatus @default(PAUSED)
    syncDirection       SyncDirection     @default(TWO_WAY)
    label               String
    baseUrl             String
    principalUrl        String?
    addressBookUrl      String?
    addressBookDisplayName String?
    remoteAccountId     String?
    remoteCTag          String?
    credentialReference String?
    credentialVersion   Int               @default(1)
    credentialUpdatedAt DateTime?
    credentialLastValidatedAt DateTime?
    credentialRevokedAt DateTime?
    encryptionKeyRef    String?
    connectionValidatedAt DateTime?
    lastSyncCursor      String?
    lastSyncedAt        DateTime?
    lastSucceededAt     DateTime?
    lastErrorAt         DateTime?
    lastErrorCode       String?
    lastErrorMessage    String?
    // P23-03: cached CardDAV book discovery — array of { url, displayName, ctag,
    // readOnly } objects, refreshed on demand (1h TTL) by the book allowlist UI.
    discoveredBooks     Json?
    booksDiscoveredAt   DateTime?
    // P36-DB02: initial-setup gate. null = the connection was just created and the
    // user hasn't confirmed sync settings yet — the first sync is held and the
    // scheduler skips it until completeSyncSetup() stamps this. Existing rows are
    // backfilled to createdAt so they keep syncing.
    setupCompletedAt    DateTime?
    // P36-DB03: when the user soft-disconnected this connection (status DISCONNECTED).
    disconnectedAt      DateTime?
    retiredAt           DateTime?
    retiredReason       String?
    createdAt           DateTime          @default(now())
    updatedAt           DateTime          @updatedAt
    user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
    replacesSyncAccount SyncAccount?      @relation("SyncAccountReplaces", fields: [replacesSyncAccountId], references: [id], onDelete: SetNull)
    replacementChildren SyncAccount[]     @relation("SyncAccountReplaces")
    replacedBySyncAccount SyncAccount?    @relation("SyncAccountReplacedBy", fields: [replacedBySyncAccountId], references: [id], onDelete: SetNull)
    replacedAccounts    SyncAccount[]     @relation("SyncAccountReplacedBy")
    syncLinks           SyncContactLink[]
    syncJobs            SyncJob[]
    syncConflicts       SyncConflict[]
    teamLink            TeamSyncAccount?
    settings            SyncAccountSettings?

    @@index([userId, status, updatedAt])
    @@index([connectionId])
    @@index([replacesSyncAccountId])
    @@index([replacedBySyncAccountId])
    @@unique([userId, baseUrl, label])
}

// P23-01: per-connection configuration beyond the credential/endpoint fields on
// SyncAccount. 1:1 with SyncAccount, created lazily on first save (see
// getOrCreateSyncAccountSettings). Additive and backwards-compatible: accounts
// without a row fall back to the column defaults below.
model SyncAccountSettings {
    id                   String         @id @default(cuid())
    syncAccountId        String         @unique
    syncDirection        SyncDirection  @default(TWO_WAY)
    conflictPolicy       ConflictPolicy @default(SERVER_WINS)
    // P34K: optional per-connection capability override for CardDAV providers.
    // null = auto-detect from the provider fingerprint; non-null forces a known
    // capability profile such as generic-safe, iCloud, or Fastmail.
    capabilityProfileOverride String?
    // empty = sync all discovered books; otherwise the remote address-book URLs to include
    bookAllowlist        String[]
    // null = platform default (60 min); 0 = manual only (the "Manual only" UI option)
    syncFrequencyMinutes Int?
    // P23-06: require password re-auth before editing connection settings
    requireReauthToEdit  Boolean        @default(true)

    // P36 — advanced settings
    // Auto-label: apply this label to every contact imported from this account (null = none)
    importLabelId        String?
    // Deletion safety: pause and alert if a single sync job would delete more than this many contacts (null = disabled)
    maxDeletionsThreshold Int?
    // Notify user via in-app + email when this account hits an error or auth failure
    notifyOnFailure      Boolean        @default(true)
    // Sync window: only run scheduled syncs within this local-hour range (null = no restriction, 0–23)
    syncWindowStart      Int?
    syncWindowEnd        Int?
    // Field exclusions: vCard field names to skip during sync (e.g. "NOTE", "BDAY")
    excludedFields       String[]
    // Export label filter: only push contacts with one of these label IDs to remote (empty = push all)
    exportLabelFilter    String[]
    // Retry sensitivity: auto-pause after this many consecutive failures (null = platform default of 5)
    maxAttemptsBeforePause Int?

    lastModifiedAt       DateTime       @updatedAt
    createdAt            DateTime       @default(now())

    syncAccount SyncAccount @relation(fields: [syncAccountId], references: [id], onDelete: Cascade)
    importLabel Label?      @relation(fields: [importLabelId], references: [id], onDelete: SetNull)
}

// P23-06: short-lived (15 min) "sudo mode" elevation, proving the user re-entered
// their password before changing sensitive sync settings. Tied to the session's
// UserSession id (jti) so a new login / revoke invalidates it.
model SyncSettingsElevation {
    id        String   @id @default(cuid())
    userId    String
    jti       String
    expiresAt DateTime
    createdAt DateTime @default(now())

    @@unique([userId, jti])
    @@index([userId, jti])
}

model SyncContactLink {
    id             String      @id @default(cuid())
    syncAccountId  String
    contactId      String
    remoteHref     String?
    remoteUid      String?
    remoteETag     String?
    capabilityProfileId String?
    supportedFieldShadow Json?
    lastSyncedAt   DateTime?
    tombstonedAt   DateTime?
    remoteDeletedAt DateTime?
    lastErrorCode  String?
    lastErrorMessage String?
    createdAt      DateTime    @default(now())
    updatedAt      DateTime    @updatedAt
    syncAccount    SyncAccount @relation(fields: [syncAccountId], references: [id], onDelete: Cascade)
    contact        Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
    syncConflicts  SyncConflict[]

    @@unique([syncAccountId, contactId])
    @@unique([syncAccountId, remoteHref])
    @@unique([syncAccountId, remoteUid])
    @@index([contactId, updatedAt])
    @@index([syncAccountId, tombstonedAt])
}

model SyncJob {
    id                 String         @id @default(cuid())
    syncAccountId      String
    status             SyncJobStatus  @default(QUEUED)
    trigger            SyncJobTrigger @default(MANUAL)
    syncDirection      SyncDirection
    attemptCount       Int            @default(0)
    maxAttempts        Int            @default(5)
    nextRetryAt        DateTime?
    leaseExpiresAt     DateTime?
    workerId           String?
    idempotencyKey     String?
    cursorBefore       String?
    cursorAfter        String?
    // Inbound (remote -> Kontax) tallies.
    createdCount       Int            @default(0)
    updatedCount       Int            @default(0)
    deletedCount       Int            @default(0)
    conflictCount      Int            @default(0)
    // P34D-03: outbound (Kontax -> remote) tallies, shown as the second line in
    // the Sync History "Changes" column.
    pushedCreatedCount Int            @default(0)
    pushedUpdatedCount Int            @default(0)
    pushedDeletedCount Int            @default(0)
    // P27-08: merge suggestions detected after an initial OAuth full import.
    duplicatesDetectedCount Int        @default(0)
    skippedCount       Int            @default(0)
    errorCode          String?
    errorSummary       String?
    startedAt          DateTime?
    completedAt        DateTime?
    createdAt          DateTime       @default(now())
    updatedAt          DateTime       @updatedAt
    syncAccount        SyncAccount    @relation(fields: [syncAccountId], references: [id], onDelete: Cascade)

    @@index([syncAccountId, status, createdAt])
    @@index([status, nextRetryAt])
    @@unique([syncAccountId, idempotencyKey])
}

model SyncConflict {
    id                 String                 @id @default(cuid())
    syncAccountId      String?
    syncContactLinkId  String?
    contactId          String?
    appPasswordId      String?
    conflictType       SyncConflictType
    conflictSource     SyncConflictSource     @default(OUTBOUND_SYNC)
    status             SyncConflictStatus     @default(OPEN)
    resolutionStrategy SyncResolutionStrategy?
    localSyncVersion   Int?
    remoteETag         String?
    localSnapshot      Json?
    remoteSnapshot     Json?
    resolutionNotes    String?
    lastErrorAt        DateTime?
    lastErrorCode      String?
    detectedAt         DateTime               @default(now())
    resolvedAt         DateTime?
    createdAt          DateTime               @default(now())
    updatedAt          DateTime               @updatedAt
    syncAccount        SyncAccount?           @relation(fields: [syncAccountId], references: [id], onDelete: Cascade)
    syncContactLink    SyncContactLink?       @relation(fields: [syncContactLinkId], references: [id], onDelete: SetNull)
    contact            Contact?               @relation(fields: [contactId], references: [id], onDelete: SetNull)
    appPassword        AppPassword?           @relation(fields: [appPasswordId], references: [id], onDelete: SetNull)

    @@index([syncAccountId, status, detectedAt])
    @@index([contactId, status])
    @@index([syncContactLinkId, status])
    @@index([appPasswordId, status])
    @@index([conflictSource, status, detectedAt])
}

enum EventType {
    CONTACT_CREATED
    CONTACT_UPDATED
    CONTACT_ARCHIVED
    CONTACT_RESTORED
    CONTACT_DELETED
    CONTACT_MERGED
    CONTACT_MERGE_UNDONE
    CONTACT_IMPORTED
    CONTACT_SHARED
    CONTACT_SHARE_RECEIVED
    SYNC_PULLED
    SYNC_PUSHED
    SYNC_CONFLICT_DETECTED
    SYNC_CONFLICT_RESOLVED
    SYNC_CONNECTION_CONNECTED
    SYNC_CONNECTION_RECONNECTED
    SYNC_CONNECTION_DISCONNECTED
    SYNC_CONNECTION_RETIRED
    SYNC_CONNECTION_REPLACED
    // P23-06: a sync connection's settings (direction, conflict policy, frequency,
    // book allowlist) were changed — security-relevant, audited.
    SYNC_SETTINGS_CHANGED
    // P18-02+: covers profile edits, password change, email change, 2FA state changes
    ACCOUNT_UPDATED
}

enum EmailVerificationTokenType {
    SIGNUP
    EMAIL_CHANGE
}

model EmailVerificationToken {
    id          String                     @id @default(cuid())
    userId      String
    type        EmailVerificationTokenType
    tokenHash   String                     @unique
    targetEmail String
    expiresAt   DateTime
    usedAt      DateTime?
    createdAt   DateTime                   @default(now())
    user        User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId, type, usedAt])
    @@index([tokenHash])
}

// P18-05: password reset tokens (15-minute expiry, SHA-256 hash stored)
model PasswordResetToken {
    id               String    @id @default(cuid())
    userId           String
    tokenHash        String    @unique
    expiresAt        DateTime
    usedAt           DateTime?
    requestedFromIp  String?
    createdAt        DateTime  @default(now())
    user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId, usedAt, expiresAt])
    @@index([tokenHash])
}

// P18-06: per-device session tracking (jti maps JWT to a revocable DB row)
model UserSession {
    id           String    @id @default(cuid())
    userId       String
    jti          String    @unique
    ipAddress    String?
    userAgent    String?
    deviceHint   String?
    lastActiveAt          DateTime  @default(now())
    revokedAt             DateTime?
    // P18-07: set when TOTP challenge is completed for this session
    totpChallengeVerified DateTime?
    createdAt             DateTime  @default(now())
    user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId, revokedAt, lastActiveAt])
    @@index([jti])
}

// P18-07: single-use TOTP recovery codes (stored as SHA-256 hashes)
model TotpRecoveryCode {
    id        String    @id @default(cuid())
    userId    String
    codeHash  String
    usedAt    DateTime?
    createdAt DateTime  @default(now())
    user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId, usedAt])
}

enum Actor {
    USER
    SYNC
    IMPORT
    SHARE
    FAMILY_MEMBER
    TEAM_MEMBER
    SYSTEM
    API
}

model ActivityEvent {
    id          String    @id @default(cuid())
    userId      String
    contactId   String?
    eventType   EventType
    actor       Actor
    actorDetail String?
    payload     Json      @default("{}")
    createdAt   DateTime  @default(now())

    user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    contact     Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)

    @@index([userId, createdAt(sort: Desc)])
    @@index([contactId, createdAt(sort: Desc)])
}

// --- Internal admin tooling (Phase 21) -----------------------------------------

// P21-02: append-only audit trail for every privileged admin action. Separate
// from ActivityEvent (which is user-scoped) so admin activity never pollutes a
// user's own history. targetEmail is denormalised so the log survives the
// target account being hard-deleted.
model AdminAuditEvent {
    id           String   @id @default(cuid())
    adminUserId  String
    action       String
    targetUserId String?
    targetEmail  String?
    details      Json     @default("{}")
    ipAddress    String?
    createdAt    DateTime @default(now())
    admin        User     @relation("AdminActor", fields: [adminUserId], references: [id], onDelete: Cascade)

    @@index([adminUserId, createdAt(sort: Desc)])
    @@index([action, createdAt(sort: Desc)])
    @@index([targetUserId, createdAt(sort: Desc)])
}

// P21-08: feature-flag gating with per-user allow-list and percentage rollout.
enum FeatureFlagMode {
    OFF
    SPECIFIC_USERS
    ALL
    ROLLOUT
}

model FeatureFlag {
    id             String          @id @default(cuid())
    key            String          @unique
    name           String
    description    String          @default("")
    mode           FeatureFlagMode @default(OFF)
    // Percentage of all users (0-100) when mode = ROLLOUT.
    rolloutPct     Int             @default(0)
    // Explicit allow-list of userIds when mode = SPECIFIC_USERS.
    allowedUserIds String[]        @default([])
    updatedById    String?
    updatedByName  String?
    createdAt      DateTime        @default(now())
    updatedAt      DateTime        @updatedAt
}

// --- Group scaffolding (P11-02) ------------------------------------------------
// Empty structural models for Family/Teams shared books. No product logic yet —
// Phases 13 (Family) and 14 (Teams) build the behaviour on top of these.

model Group {
    id             String             @id @default(cuid())
    ownerId        String
    type           GroupType
    name           String
    subscriptionId String?
    memberSlotsLimit Int?
    // P13-01: operational fields. Family v1 caps at 6 members (owner + 5).
    maxMembers     Int                @default(6)
    defaultAddressBookId String?
    // Set when owner downgrades from TEAMS; grace expires 14 days after billing period end.
    // null = active (or re-upgraded). Non-null + future = grace. Non-null + past = locked.
    teamsGraceEndsAt DateTime?
    // P34F-01: org-level entitlement. Once Teams billing is org-anchored, the
    // team's "is Teams active" can no longer be read off the owner's personal
    // entitlements — it lives here, maintained by upsertGroupSubscription.
    // Mirrors the existing teamsGraceEndsAt-on-Group pattern. Read by the team
    // active/grace paths (team-access, teams/page, welcome/[plan]) — see P34F §08.
    teamsEnabled     Boolean            @default(false)
    createdAt      DateTime           @default(now())
    updatedAt      DateTime           @updatedAt
    owner          User               @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
    // The team's *current* subscription pointer (canonical "active sub").
    subscription   Subscription?      @relation("GroupCurrentSubscription", fields: [subscriptionId], references: [id], onDelete: SetNull)
    // P34F-01: subscription rows *owned by* this org (org-anchored Teams billing).
    subscriptions  Subscription[]     @relation("GroupOrgSubscriptions")
    // P34F-01: the org's Stripe customer (Teams). Null for non-billing groups.
    billingCustomer SubscriptionCustomer?
    members        GroupMember[]
    addressBooks   GroupAddressBook[]
    teamSyncAccounts TeamSyncAccount[]

    @@index([ownerId])
    @@index([subscriptionId])
}

model GroupMember {
    id           String            @id @default(cuid())
    groupId      String
    // userId is null for an invite sent to an email that has no Kontax account
    // yet; it is linked on accept/registration (mirrors ContactShare).
    userId       String?
    invitedEmail String?
    role         GroupRole         @default(MEMBER)
    inviteStatus GroupInviteStatus @default(PENDING)
    // P13-01/02: edit permission, invite token (48h), and invite/accept tracking.
    canEdit         Boolean        @default(true)
    // P34F-01: org billing access, independent of the Admin role. The owner is
    // always an implicit billing manager regardless of this flag (backstop so an
    // org can't be locked out of its own billing) — see canManageGroupBilling.
    canManageBilling Boolean       @default(false)
    // P14-01 (Teams): per-book permission map { [addressBookId]: "EDIT"|"VIEW"|"NONE" }.
    // JSON for flexibility; if book-level permission queries get hot, normalise
    // into a GroupMemberAddressBookPermission join table (documented tradeoff).
    addressBookPermissions Json?
    inviteToken     String?        @unique
    inviteExpiresAt DateTime?
    invitedAt       DateTime       @default(now())
    invitedByUserId String?
    joinedAt        DateTime?
    createdAt    DateTime          @default(now())
    group        Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
    user         User?             @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([groupId, userId])
    @@unique([groupId, invitedEmail])
    @@index([userId, inviteStatus])
    @@index([groupId, inviteStatus])
    @@index([invitedEmail, inviteStatus])
}

model GroupAddressBook {
    id          String   @id @default(cuid())
    groupId     String
    name        String
    description String?
    // P13-01: Family v1 has a single default book; Teams may have several
    // (created with isDefault=false).
    isDefault   Boolean  @default(true)
    // P14-01 (Teams): archived books are read-only + hidden from default views.
    archivedAt  DateTime?
    // P18-11: AddressBook.id of the personal book created for the owner when this group book dissolves.
    // Not a FK — stored as plain string to survive group book archival (Phase 13 writes this).
    dissolvedToBookId String?
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
    group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
    contacts    GroupContact[]
    teamSyncAccounts TeamSyncAccount[]

    @@index([groupId])
}

// P18-11: personal address book (one default per user; model supports multiple for Phase 28+)
model AddressBook {
    id                String    @id @default(cuid())
    userId            String
    name              String
    slug              String    // URL-safe, used in CardDAV paths (e.g. "default")
    description       String?
    isDefault         Boolean   @default(false)
    // P23-07: Kontax-as-CardDAV-server device settings. deviceWritable=false makes
    // the book read-only to connected devices (PUT/DELETE → 403). sourceBookIds, when
    // non-empty, aggregates contacts from those personal books into this collection;
    // empty preserves the default per-book scope (contacts whose bookId is this book).
    deviceWritable    Boolean   @default(true)
    sourceBookIds     String[]
    // Preserved so re-subscription can locate former shared-book contacts (Phase 13)
    sourceGroupBookId String?
    archivedAt        DateTime?
    createdAt         DateTime  @default(now())
    updatedAt         DateTime  @updatedAt

    user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    contacts Contact[]

    @@unique([userId, slug])
    @@index([userId, isDefault])
    @@index([userId, archivedAt])
}

// P28-02: a "smart list" — a named, persisted snapshot of the contacts-list
// filter state (the URL query params). filterState is the serialised
// ContactFilterState (see ~/lib/contact-filter-state); stored as JSON so new
// filter keys are captured without a schema change. Personal only (no sharing).
model SavedFilter {
    id          String    @id @default(cuid())
    userId      String
    name        String
    filterState Json
    sortOrder   Int       @default(0)
    lastUsedAt  DateTime?
    usageCount  Int       @default(0)
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId, sortOrder])
}

// P31B-01: per-user label registry. Contact.labels[] remains the source of
// truth for membership; this table holds canonical name + color + position so
// rename / recolor / merge have a single home. Backfilled from existing
// Contact.labels values on first use (see actions/labels.ts ensureRegistry).
model Label {
    id        String   @id @default(cuid())
    userId    String
    name      String
    color     String   // one of the 8-swatch palette hex values
    position  Int      @default(0)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    syncAccountSettings SyncAccountSettings[]

    @@unique([userId, name])
    @@index([userId, position])
}

// P14-01 (Teams): links an existing personal SyncAccount to a team address book
// so the team's contacts sync to an external CardDAV provider (Google Workspace,
// Nextcloud, …). Owned by the team, configured by an admin.
model TeamSyncAccount {
    id            String           @id @default(cuid())
    groupId       String
    syncAccountId String
    addressBookId String
    addedByUserId String
    createdAt     DateTime         @default(now())
    group         Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
    syncAccount   SyncAccount      @relation(fields: [syncAccountId], references: [id], onDelete: Cascade)
    addressBook   GroupAddressBook @relation(fields: [addressBookId], references: [id], onDelete: Cascade)

    @@unique([syncAccountId])
    @@index([groupId])
    @@index([addressBookId])
}

// P13-01: a contact that lives in a shared address book. The contact is owned
// by the group (nominally the group owner's userId on the Contact row); access
// and mutation are gated by GroupMember, not Contact.userId. "Add to family
// book" creates a new Contact + GroupContact (a copy, not a move).
model GroupContact {
    id                 String           @id @default(cuid())
    groupAddressBookId String
    contactId          String
    addedByUserId      String
    createdAt          DateTime         @default(now())
    updatedAt          DateTime         @updatedAt
    groupAddressBook   GroupAddressBook @relation(fields: [groupAddressBookId], references: [id], onDelete: Cascade)
    contact            Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)

    @@unique([groupAddressBookId, contactId])
    @@index([groupAddressBookId, updatedAt])
    @@index([contactId])
}

// --- Contact sharing (Phase 12) ----------------------------------------------

enum ShareType {
    VCARD_LINK
    STATIC_COPY
    LIVE_SYNC
}

enum ShareStatus {
    ACTIVE
    REVOKED
    EXPIRED
    DECLINED
}

model ContactShare {
    id                 String      @id @default(cuid())
    ownerUserId        String
    contactId          String?
    shareType          ShareType
    token              String?     @unique
    recipientUserId    String?
    recipientEmail     String?
    recipientContactId String?
    status             ShareStatus @default(ACTIVE)
    // Snapshot of the shared contact's portable fields at share time, so a
    // static share is still deliverable if the owner edits/archives/deletes the
    // original before the recipient accepts (P12-03).
    snapshot           Json?
    expiresAt          DateTime?
    revokedAt          DateTime?
    lastPushedAt       DateTime?
    // Live-sync propagation error state (P12-08): set when a push to the recipient
    // is paused (e.g. recipient account locked); cleared on the next success.
    lastErrorAt        DateTime?
    lastErrorCode      String?
    downloadCount      Int         @default(0)
    maxDownloads       Int?        // null = unlimited; 1 = single-use
    createdAt          DateTime    @default(now())
    updatedAt          DateTime    @updatedAt
    owner              User        @relation("ShareOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
    contact            Contact?    @relation("ShareSourceContact", fields: [contactId], references: [id], onDelete: SetNull)
    recipientUser      User?       @relation("ShareRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull)
    recipientContact   Contact?    @relation("ShareRecipientContact", fields: [recipientContactId], references: [id], onDelete: SetNull)

    @@index([ownerUserId, status, createdAt])
    @@index([recipientUserId, status])
    @@index([recipientEmail, status])
}

model StripeWebhookEvent {
    id            String   @id @default(cuid())
    stripeEventId String   @unique
    type          String
    processedAt   DateTime @default(now())
    error         String?

    @@index([stripeEventId])
    @@index([processedAt])
}

// --- Notification & suspicious-activity layer (Phase 22, P22-DB05) -------------

enum NotificationCategory {
    SECURITY
    SHARING
    SYNC_STATUS
    BILLING
    REMINDERS
    PRODUCT_UPDATES
}

enum DigestCadence {
    NONE
    DAILY
    WEEKLY
}

// In-app notification feed row. One per user-facing event; the bell badge counts
// unread (read=false), the dropdown lists non-dismissed rows newest-first.
model Notification {
    id              String               @id @default(cuid())
    userId          String
    category        NotificationCategory
    title           String
    body            String
    read            Boolean              @default(false)
    readAt          DateTime?
    dismissedAt     DateTime?
    // SHARING uses this to deep-link (e.g. "/shares"); null otherwise.
    actionUrl       String?
    // SECURITY rows deep-link 1:1 to their anomaly (Resolution 3).
    securityAlertId String?
    createdAt       DateTime             @default(now())

    user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
    securityAlert SecurityAlert? @relation(fields: [securityAlertId], references: [id], onDelete: SetNull)

    @@index([userId, createdAt(sort: Desc)])
    @@index([userId, read])
}

// Persisted anomaly record behind a SECURITY notification. kind drives the drawer
// variant: "device" → IP/device block, "bulk" → affected-contacts event list.
model SecurityAlert {
    id         String    @id @default(cuid())
    userId     String
    kind       String
    title      String
    summary    String
    // device: { "Device", "IP address", "Time" } · bulk: { events:[{name,at}], more }
    payload    Json      @default("{}")
    // null = active (shows in banner) · "DISMISSED" (that-was-me) · "SECURED" (wasn't-me)
    resolution String?
    resolvedAt DateTime?
    createdAt  DateTime  @default(now())

    user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
    notifications Notification[]

    @@index([userId, createdAt(sort: Desc)])
}

// Per-user notification preferences. One row per user (lazily created with the
// brief's defaults). SECURITY and BILLING are always-on and have no columns.
model NotificationSettings {
    userId         String        @id
    sharingInApp   Boolean       @default(true)
    sharingEmail   Boolean       @default(true)
    syncInApp      Boolean       @default(true)
    syncEmail      Boolean       @default(true)
    remindersInApp Boolean       @default(true)
    remindersEmail Boolean       @default(false)
    productInApp   Boolean       @default(true)
    productEmail   Boolean       @default(false)
    digest         DigestCadence @default(NONE)

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// P22-04: records failed sign-in attempts against an existing account so the
// "repeated failed logins" rule (>5 in 1h) can fire a security alert.
model FailedLoginAttempt {
    id        String   @id @default(cuid())
    userId    String
    ipAddress String?
    createdAt DateTime @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId, createdAt(sort: Desc)])
}

// P22-09: dedup state for birthday/anniversary reminders — one row per
// (user, contact, dateKey); lastSentYear prevents re-firing within a calendar year.
model BirthdayReminderState {
    id           String   @id @default(cuid())
    userId       String
    contactId    String
    dateKey      String // "birthday" | "significant-<index>"
    lastSentYear Int
    lastSentAt   DateTime @default(now())

    user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

    @@unique([userId, contactId, dateKey])
    @@index([userId, lastSentYear])
}

// P25-03: records when a user accepts a non-top suggestion or rejects a chip — used
// offline to improve classifier patterns.
model ImportMappingSuggestionFeedback {
    id             String   @id @default(cuid())
    userId         String
    columnHeader   String
    suggestedField String
    chosenField    String
    sampleValue    String?
    createdAt      DateTime @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([columnHeader])
    @@index([userId])
}

// P25-04: saved column-mapping presets; matched by SHA-256 of sorted header names.
model ImportMappingPreset {
    id             String   @id @default(cuid())
    userId         String
    name           String
    headerHash     String
    columnMappings Json
    sourceProfile  String?
    usageCount     Int      @default(1)
    lastUsedAt     DateTime @default(now())
    createdAt      DateTime @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId, headerHash])
    @@index([userId, lastUsedAt(sort: Desc)])
}

// P25-06: saved export field selections
model ExportPreset {
    id             String   @id @default(cuid())
    userId         String
    name           String
    fieldSelection Json
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId, createdAt(sort: Desc)])
}

// P29-02: tracks async GDPR data-export job lifecycle. One active (PENDING /
// PROCESSING / READY) job per user at a time. A CRON runner advances the status;
// a second CRON expires READY jobs after 48 hours.
model DataExportJob {
    id               String           @id @default(cuid())
    userId           String
    status           DataExportStatus @default(PENDING)
    includeArchived  Boolean          @default(false)
    downloadUrl      String?          // null until READY; pre-signed MinIO URL
    fileSizeBytes    Int?
    requestedAt      DateTime         @default(now())
    startedAt        DateTime?
    completedAt      DateTime?
    expiresAt        DateTime?        // requestedAt + 48 h, set on READY
    errorMessage     String?
    user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId, status])
    @@index([status, expiresAt])
}

model ApiToken {
    id                    String        @id @default(cuid())
    userId                String
    name                  String
    tokenHash             String        @unique
    tokenPrefix           String        // first 12 chars of plaintext, e.g. "ktx_live_7f3"
    scope                 ApiTokenScope @default(READ_ONLY)
    lastUsedAt            DateTime?
    requestCountThisMonth Int           @default(0)
    createdAt             DateTime      @default(now())
    revokedAt             DateTime?

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId, name])
    @@index([userId, revokedAt])
    @@index([tokenHash])
}

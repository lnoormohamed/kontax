{
  "name": "kontax",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "next lint && tsc --noEmit",
    "db:check:drift": "node scripts/check-schema-drift.mjs",
    "db:generate": "prisma migrate dev",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "dev": "next dev --turbo",
    "email:preview": "email dev --dir src/emails --port 3001",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "postinstall": "prisma generate",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "preview": "next build && next start",
    "test:repo": "node --experimental-strip-types --loader ./scripts/node-test-loader.mjs --test tests/node/*.test.ts",
    "test:sync-fixtures": "node --experimental-strip-types --loader ./scripts/node-test-loader.mjs --test tests/node/sync-provider-capabilities.test.ts tests/node/sync-provider-identity.test.ts",
    "test:e2e": "playwright test",
    "migrate:books": "node scripts/migrate-default-address-books.mjs",
    "backfill:book-memberships": "node scripts/backfill-contact-book-memberships.mjs",
    "backfill:sync-lineage": "node scripts/backfill-sync-account-lineage.mjs",
    "migrate:teams-billing": "node scripts/migrate-teams-billing-to-org.mjs",
    "migrate:teams-billing:apply": "node scripts/migrate-teams-billing-to-org.mjs --apply",
    "prune:activity": "node scripts/prune-activity-retention.mjs",
    "seed:phase37:central-eastern-europe": "node scripts/seed-phase37-central-eastern-europe.mjs",
    "seed:phase37:mena": "node scripts/seed-phase37-mena.mjs",
    "seed:phase37:nanp": "node scripts/seed-phase37-nanp.mjs",
    "seed:phase37:nordics-baltics": "node scripts/seed-phase37-nordics-baltics.mjs",
    "seed:phase37:pacific": "node scripts/seed-phase37-au-nz-pacific.mjs",
    "qa:phase37:phones": "node scripts/phase37-phone-qa-harness.mjs",
    "qa:phase44:photos": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --dns-result-order=ipv4first --network-family-autoselection-attempt-timeout=2000 --experimental-strip-types --loader ./scripts/node-test-loader.mjs scripts/phase44-photo-roundtrip-harness.ts",
    "qa:phase44:photo-decision": "node --experimental-strip-types --loader ./scripts/node-test-loader.mjs scripts/phase44-photo-decision-selftest.ts",
    "qa:phase45:archive": "node --experimental-strip-types --loader ./scripts/node-test-loader.mjs scripts/phase45-archive-selftest.ts",
    "seed:phase37:sub-saharan-africa": "node scripts/seed-phase37-sub-saharan-africa.mjs",
    "seed:phase37:southern-europe": "node scripts/seed-phase37-southern-europe.mjs",
    "seed:phase37:uk-ie": "node scripts/seed-phase37-uk-ireland.mjs",
    "seed:phase37:western-europe": "node scripts/seed-phase37-western-europe.mjs",
    "seed:demo": "node scripts/seed-demo-showcase.mjs",
    "seed:demo:multilingual": "node scripts/seed-multilingual-demo-contacts.mjs",
    "start": "node server.mjs",
    "start:production": "node scripts/start-production.mjs",
    "typecheck": "tsc --noEmit",
    "seed:phase37:asia-latam": "node scripts/seed-phase37-asia-latam.mjs",
    "search:setup-index": "node scripts/setup-contact-search-index.mjs",
    "backfill:avatar-thumbs": "node scripts/backfill-avatar-thumbs.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.2",
    "@aws-sdk/client-s3": "^3.1066.0",
    "@aws-sdk/client-sesv2": "^3.1065.0",
    "@aws-sdk/s3-request-presigner": "^3.1068.0",
    "@azure/msal-node": "^5.2.4",
    "@googleapis/people": "^7.0.1",
    "@paralleldrive/cuid2": "^3.3.0",
    "@prisma/client": "^6.6.0",
    "@react-email/components": "^1.0.12",
    "@t3-oss/env-nextjs": "^0.12.0",
    "@tanstack/react-virtual": "^3.14.2",
    "@use-gesture/react": "^10.3.1",
    "adm-zip": "^0.5.18",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "ioredis": "^5.11.1",
    "next": "^15.2.3",
    "next-auth": "5.0.0-beta.25",
    "otpauth": "^9.5.1",
    "pinyin-pro": "^3.28.1",
    "qrcode": "^1.5.4",
    "rate-limiter-flexible": "^11.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-email": "^6.6.0",
    "sharp": "^0.35.3",
    "stripe": "^22.2.0",
    "transliteration": "^2.6.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@next/bundle-analyzer": "^16.2.9",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "^4.0.15",
    "@types/adm-zip": "^0.5.8",
    "@types/archiver": "^8.0.0",
    "@types/node": "^20.14.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.23.0",
    "eslint-config-next": "^15.2.3",
    "playwright": "^1.61.0",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "prisma": "^6.6.0",
    "tailwindcss": "^4.0.15",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.27.0"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  },
  "packageManager": "npm@11.6.2"
}

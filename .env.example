# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# ─── REQUIRED IN PRODUCTION — P48-16 ─────────────────────────────────────────
# The process refuses to boot when NODE_ENV=production (or
# KONTAX_DEPLOY_ENV=production) and any of these is unset, because each one has
# a silent-but-broken failure mode rather than an obvious one:
#
#   DATABASE_URL                      (always required)
#   AUTH_SECRET                       session JWTs + impersonation HMAC
#   APP_URL                           every absolute link we generate
#   TOTP_ENCRYPTION_KEY(S)            TOTP secrets at rest
#   SYNC_CREDENTIAL_ENCRYPTION_KEY(S) provider credentials at rest
#   CRON_SECRET                       /api/cron/* guard
#   REDIS_URL                         shared rate-limit store
#
# Rotation procedure and blast radius per secret: roadmap/runbooks/env-secrets.md
# SKIP_ENV_VALIDATION=1 bypasses the check — build steps only, never runtime.

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate: npx auth secret
# Rotating invalidates every active session.
AUTH_SECRET=""

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/kontax"

# ─── App ─────────────────────────────────────────────────────────────────────
# Public origin — used for CardDAV URLs, share links, email CTAs and OAuth
# redirects. Set this in production so the correct scheme is used regardless of
# reverse-proxy header forwarding. Outside production it defaults to
# http://localhost:3000; in production an unset value is a hard error.
# APP_URL="https://kontax.example.com"

# Deployment marker. "production" makes the required-env and Redis guards fire
# even when NODE_ENV is not "production" (e.g. a maintenance script run against
# prod). Also drives the schema mode — see roadmap/runbooks/deploy.md.
# KONTAX_DEPLOY_ENV="production"

# ─── Provider credential encryption — P48-16 keyring ─────────────────────────
# Encrypts stored CardDAV/Google/Microsoft credentials (SyncAccount rows).
#
# Keyring form — "id:hex64,id:hex64", CURRENT KEY FIRST. New rows are written
# under the first entry; every other entry is retained so existing rows still
# decrypt. This is what makes rotation an online operation:
#   1. prepend the new key, redeploy
#   2. node scripts/rotate-sync-credential-key.mjs --apply
#   3. drop the old key, redeploy
# Generate a key: openssl rand -hex 32
# SYNC_CREDENTIAL_ENCRYPTION_KEYS="k2:<hex64>,k1:<hex64>"
#
# Single-key form (pre-keyring, still supported). Kept as a decrypt-only key
# when the keyring above is also set, so adopting the keyring needs no
# re-encryption first. Default key id is "k1".
# SYNC_CREDENTIAL_ENCRYPTION_KEY=""
# SYNC_CREDENTIAL_ENCRYPTION_KEY_ID="k1"
#
# Legacy: rows written before a dedicated key existed were encrypted under
# AUTH_SECRET. That key is always registered for decryption under the id
# "legacy", so those rows keep opening and are upgraded lazily on next sync.

# ─── Outbound request policy — P48-04 ────────────────────────────────────────
# Every server-side fetch of a user- or remote-supplied URL (CardDAV servers,
# vCard photo URIs, pasted avatars) is SSRF-guarded: public hosts only, https
# only in production. Set to 1 ONLY in local dev to allow http:// CardDAV
# servers (e.g. a Radicale on your LAN is still blocked by the private-range
# rule; use a public hostname or a tunnel).
# KONTAX_ALLOW_INSECURE_OUTBOUND="0"

# ─── Rate limiting — self-hosted Valkey (P18-10) ─────────────────────────────
# Falls back to in-memory store in dev if unset (not shared across instances).
# REQUIRED in production — boot fails without it (P48-16), because a per-process
# fallback silently turns cluster-wide limits into limits that reset on deploy.
# During a Redis *outage* every limiter falls through to a per-process memory
# insurance limiter, so protection degrades rather than disappearing, a warning
# is logged once a minute, and recovery needs no restart.
# REDIS_URL="redis://192.168.x.x:6379"

# ─── Blob storage — self-hosted MinIO (P18-01) ───────────────────────────────
# Required for avatar file uploads. Falls back to URL-input-only mode if unset.
# MINIO_ENDPOINT="https://minio.yourdomain.com"
# MINIO_ACCESS_KEY=""
# MINIO_SECRET_KEY=""
# MINIO_BUCKET="kontax-uploads"
# MINIO_PUBLIC_URL="https://minio.yourdomain.com/kontax-uploads"

# ─── TOTP encryption — P18-07, keyring P48-16 ────────────────────────────────
# Required in production. Generate: openssl rand -hex 32
# Same keyring semantics as the credential key above — current key first:
# TOTP_ENCRYPTION_KEYS="t2:<hex64>,t1:<hex64>"
# Single-key form (retained as a decrypt-only key under id "t1"):
# TOTP_ENCRYPTION_KEY=""
# Rotate stored secrets with:
#   node scripts/rotate-sync-credential-key.mjs --totp --apply

# ─── Cron jobs — P18-10 ──────────────────────────────────────────────────────
# Sent as x-cron-secret header by LXC cron curl calls. Generate: openssl rand -hex 32
# Required in production. Rotating needs the LXC 152 crontab updated in lockstep.
# CRON_SECRET=""

# ─── Google OAuth — Contacts sync connector (P27-01) ─────────────────────────
# OAuth 2.0 client from Google Cloud Console. Enable the People API and request
# the sensitive "contacts" scope (requires Google app verification before
# general availability — can take 2–6 weeks; add test users meanwhile).
# The Google sync connector is only offered when all three are set.
# The same client may later also back login OAuth (P18-08, deferred).
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_REDIRECT_URI="https://app.getkontax.com/api/sync/google/callback"

# ─── Microsoft OAuth — Outlook/Exchange sync connector (P27-04) ──────────────
# Azure AD app registration. Add Microsoft Graph delegated permissions
# Contacts.ReadWrite + User.Read + offline_access. TENANT_ID "common" allows
# both personal (Outlook.com) and work/school (Microsoft 365) accounts; use
# "organizations" to restrict to work accounts. The connector is only offered
# when client id/secret/redirect are set.
# MICROSOFT_CLIENT_ID=""
# MICROSOFT_CLIENT_SECRET=""
# MICROSOFT_TENANT_ID="common"
# MICROSOFT_REDIRECT_URI="https://app.getkontax.com/api/sync/microsoft/callback"

# ─── OAuth providers — deferred to TBD (P18-08) ──────────────────────────────
# APPLE_CLIENT_ID=""
# APPLE_TEAM_ID=""
# APPLE_KEY_ID=""
# APPLE_PRIVATE_KEY=""

# ─── Transactional email — Amazon SES (Phase 20) ─────────────────────────────
# Leave empty in dev — emails log to console. All four are required together;
# if any is missing, SES_CONFIGURED is false and email stays in console mode.
# Setup steps: roadmap/runbooks/ses-setup.md
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_SES_REGION=""          # region the SES domain identity was verified in
# EMAIL_FROM=""              # must be an address on the verified domain

# ─── Stripe Customer Portal — configure in Stripe dashboard ─────────────────
# Settings > Billing > Customer portal. Required settings:
#   - Update payment methods: ✓
#   - View invoice history: ✓
#   - Cancel subscriptions: ✓ (cancel at end of period, not immediately)
#   - Update subscriptions (plan changes): ✓ — set allowed prices
#   - Return URL: {APP_URL}/settings?portal=returned

# ─── Stripe billing — Phase 19 ───────────────────────────────────────────────
# All optional in dev — billing features fail gracefully when unset.
# Get these from the Stripe dashboard: https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY="sk_test_..."
# Get webhook secret by running: stripe listen --print-secret
# STRIPE_WEBHOOK_SECRET="whsec_..."
# Price IDs from Stripe dashboard > Products > Pricing
# STRIPE_PRICE_ID_PRO_MONTHLY="price_..."
# STRIPE_PRICE_ID_PRO_YEARLY="price_..."
# STRIPE_PRICE_ID_FAMILY_MONTHLY="price_..."
# STRIPE_PRICE_ID_FAMILY_YEARLY="price_..."
# STRIPE_PRICE_ID_TEAMS_MONTHLY="price_..."
# STRIPE_PRICE_ID_TEAMS_YEARLY="price_..."
# Promo codes: no env var needed — enable in Stripe dashboard > Promotions and
# set allow_promotion_codes: true in checkout (already set). Codes are
# validated entirely by Stripe.
# Display prices shown on the pricing page (public — no secrets here)
# NEXT_PUBLIC_PRICE_PRO_MONTHLY="£8"
# NEXT_PUBLIC_PRICE_PRO_YEARLY="£77"
# NEXT_PUBLIC_PRICE_FAMILY_MONTHLY="£14"
# NEXT_PUBLIC_PRICE_FAMILY_YEARLY="£134"
# NEXT_PUBLIC_PRICE_TEAMS_MONTHLY="£12"
# NEXT_PUBLIC_PRICE_TEAMS_YEARLY="£115"
